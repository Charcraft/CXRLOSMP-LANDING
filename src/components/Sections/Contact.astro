---
interface Props {
  profile: any;
}
const { profile } = Astro.props;
const base = import.meta.env.BASE_URL;
const email = profile?.email ?? 'charcraftycarlos@gmail.com';
const github = profile?.social?.github ?? 'https://github.com/Charcraft';
const cvHref = base?.endsWith('/') ? `${base}CV-Carlos-Martinez.pdf` : `${base}/CV-Carlos-Martinez.pdf`;
---

<section id="contact" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-fusion-bg-secondary/30" aria-labelledby="contact-title" style="scroll-margin-top: var(--header-h);">
  <div class="max-w-7xl mx-auto">
    <h2 id="contact-title" class="section-title text-center">
      Conecta <span>Conmigo</span>
    </h2>

    <div class="text-center max-w-2xl mx-auto mb-12">
      <h3 class="font-display text-xl md:text-2xl text-fusion-text-primary mb-4">
        Estudiante Ing. Software — respondo en 24h
      </h3>
      <p class="text-fusion-text-muted text-lg leading-relaxed mb-8">
        GitHub con código real + email directo
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-12">
        <a href={`mailto:${email}`} class="btn-p5 inline-flex">
          <span>Contactar</span>
        </a>
        <a href={github} target="_blank" rel="noopener noreferrer" class="btn-p3 inline-flex" aria-label="Ver GitHub de Carlos Martínez">
          <span>Ver GitHub</span>
        </a>
        <a href={cvHref} download="CV-Carlos-Martinez.pdf" class="btn-p3 inline-flex" aria-label="Descargar CV de Carlos Martínez en PDF">
          <span>Descargar CV</span>
        </a>
      </div>
      <ul id="social-links" class="flex flex-wrap justify-center gap-4 list-none p-0 m-0" aria-label="Redes sociales">
        <li><a href={github} target="_blank" rel="noopener noreferrer" class="social-link" aria-label="GitHub de Carlos Martínez (se abre en pestaña nueva)">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
        </a></li>
        <li><a href={`mailto:${email}`} class="social-link" aria-label="Email de Carlos Martínez — charcraftycarlos@gmail.com">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </a></li>

      </ul>
    </div>

    <div class="glass-p5 rounded-2xl p-8 md:p-12 max-w-2xl mx-auto">
      <h3 class="font-display text-lg md:text-xl text-fusion-highlight mb-6 text-center">¿Tienes un proyecto en mente?</h3>
      <p class="text-fusion-text-muted text-center">
        Escríbeme directamente a <a href={`mailto:${email}`} class="text-fusion-highlight hover:text-fusion-accent-primary transition-colors font-medium">{email}</a>
      </p>
    </div>
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://charcraft.github.io/CXRLOSMP-LANDING#person",
  "name": profile?.name ?? "Carlos de Jesús Martínez Pineda",
  "givenName": profile?.firstName ?? "Carlos",
  "jobTitle": profile?.title ?? "Estudiante Ingeniería en Software",
  "email": email,
  "address": { "@type": "PostalAddress", "addressLocality": "Chiapas", "addressCountry": "MX" },
  "url": "https://charcraft.github.io/CXRLOSMP-LANDING",
  "sameAs": [github, profile?.social?.youtube, profile?.social?.instagram].filter(Boolean)
})} />
<style>
  /* Fase 2: pausa overlays con animation infinite sin tocar global.css (perf) */
  .scanlines, .grain-overlay { animation: none !important; }
  @media (prefers-reduced-motion: reduce) {
    #contact * { animation: none !important; transition: none !important; }
  }
</style>

<script>
  // Social link magnetic hover (respeta reduce-motion).
  // El sonido de hover/clic lo pone el delegado global de main.ts (evita doble play).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  document.querySelectorAll('#contact .social-link').forEach((link) => {
    if (!reduceMotion) {
      link.addEventListener('mousemove', (e) => {
        const rect = link.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        link.style.transform = `translate(${x * 0.15}px, ${y * 0.15}px) scale(1.05)`;
      });
      link.addEventListener('mouseleave', () => {
        link.style.transform = 'translate(0, 0) scale(1)';
      });
    }
  });
</script>
