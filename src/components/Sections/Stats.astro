---
interface Props {
  profile: any;
}
const { profile } = Astro.props;
// Numeros reales: sin porcentajes inventados, sin emojis.
const metrics = [
  { value: "1", label: "Año estudiando" },
  { value: "2", label: "Proyectos hechos" },
  { value: "3", label: "Certificaciones Cisco" },
  { value: "24h", label: "Tiempo de respuesta" },
];
---

<section id="stats" class="py-20 md:py-32 px-4 sm:px-6 lg:px-8 bg-fusion-bg-secondary/30" aria-labelledby="stats-title" style="scroll-margin-top: var(--header-h);">
  <div class="max-w-7xl mx-auto">
    <h2 id="stats-title" class="section-title text-center">
      Stats <span>y datos</span>
    </h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-12">
      {metrics.slice(0, 4).map((m) => (
        <div class="stat-card card-p5 p-6 text-center">
          <div class="stat-value font-display text-4xl md:text-5xl text-fusion-highlight mb-1">{m.value}</div>
          <div class="stat-label font-display text-xs text-fusion-text-muted uppercase tracking-wider">{m.label}</div>
        </div>
      ))}
    </div>

    <div class="card-p5 p-8 text-center">
      <h3 class="font-display text-xl text-fusion-highlight mb-4">Disponibilidad</h3>
      <p class="text-fusion-text-muted">{profile?.availability ?? 'Disponible remoto / Chiapas'} · <a href={`mailto:${profile?.email}`} class="text-fusion-highlight hover:text-fusion-accent-primary transition-colors">{profile?.email}</a></p>
    </div>
  </div>
</section>
